          "op": "add",
          "key": "n_blank",
          "data": {
            "name": "留白｜明天还没有发生",
            "config_ref": "objects/text.toml",
            "begin": 4,
            "end": 5,
            "information": {
              "text": "结尾有意停在次日会面之前。已完成的行动是认领、求证、承认责任和约定；是否原谅、是否换掉黄线、如何谈这些年的隔阂仍留白。目的：允许亲近和愤怒并存，不用一次电话替多年关系结账。母亲去世原因与学校名称不参与谜底，不暗示隐藏事故。"
            }
          }
        }
