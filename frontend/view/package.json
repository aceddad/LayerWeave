{
  "name": "layerweave-view",
  "private": true,
  "version": "0.31.3",
  "description": "LayerWeave 视图网页的源码；npm run build 输出到 src/layerweave/tool/builtin/view/web/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && node tools/export-plugin-sdk.mjs && node tools/copy-locales.mjs && vite build",
